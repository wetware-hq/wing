flowchart TD
    subgraph CFG["Campaign manifest (single declarative file, the only human-authored artifact)"]
        M1["target: HLA-A*02:01 + b2m + SLLMWITQC"]
        M2["epitope_residues C:[0..8]  (0-based, per-chain)"]
        M3["non_binding_residues: alpha-3 + full b2m"]
        M4["decoy_panel: [peptides]  <- BIO Physician"]
        M5["binder: 60..100 aa, n=300, seed"]
        M6["gate thresholds + keep_fraction"]
        M7["spend_cap_usd + approval: REQUIRED"]
    end

    CFG --> APPR{"Mathew approves spend<br/>estimate shown, nothing submitted"}
    APPR -- no --> HALT([halt, zero cost])

    APPR -- yes --> L1

    subgraph L1["LAYER 1 - BOLTZ (hosted API, the only external dependency)"]
        B1["1a ON-TARGET DESIGN<br/>300 designs vs real epitope<br/>epitope + non_binding conditioning<br/>$15.00 @ $0.05/design"]
        B2["1b DECOY REFOLD<br/>survivors x decoy panel, same HLA<br/>prediction not design, same API"]
        B1 --> B2
    end

    L1 --> ART["Artifacts, content-addressed on<br/>(api_version, config_hash, target_hash, seed)<br/>_predicted.cif + metrics.json + pae.npz<br/>MIRRORED OFF-API IMMEDIATELY (7-day retention)"]

    ART --> L2

    subgraph L2["LAYER 2 - INTERFACE (pure CPU, this box, zero GPU, zero rent)"]
        I1["ipSAE / min_ipSAE from pae.npz<br/>computed locally, API does not return it"]
        I2["shape complementarity (Lawrence-Colman)<br/>best single discriminator, AUC 0.688"]
        I3["complex ipLDDT 0.698 | pLDDT 0.646<br/>ipTM 0.607 | pae_interaction<br/>pDockQ/pDockQ2 EXCLUDED - broken columns"]
        I4["RANK-AVERAGE, not AND-gating<br/>beats best single metric 39/45"]
        I5["SPECIFICITY MARGIN<br/>on-target rank minus best-decoy rank<br/>== the product; affinity is not"]
        I1 --> I4
        I2 --> I4
        I3 --> I4
        I4 --> I5
    end

    L2 --> DIV["Diversity / novelty filter<br/>cluster, cap per scaffold family"]

    DIV --> PANEL(["RANKED PANEL + per-design provenance<br/>every row replayable from manifest hash"])

    subgraph CAL["Calibration (sets every threshold above)"]
        C1["Adaptyv Proteinbase, ODC-BY<br/>4,273 PPIs / 17 targets, WITH NEGATIVES"]
        C2["NO pMHC in the set -> thresholds are<br/>TRANSFERRED, NOT CALIBRATED<br/>campaign one re-calibrates them"]
    end
    CAL -.-> L2

    PANEL --> HO{"Hand-off"}
    HO --> PH["BIO Physician: phases 3-5<br/>SPR/BLI, counter-screen, multimer,<br/>Jurkat-NFAT, cytotoxicity, developability"]
    HO --> EN["BIO Engineer: parallelism + provenance<br/>only if n outgrows the hosted API"]

    REM["REMOVED THIS REVISION<br/>AF2 initial-guess re-predictor (ColabFold, rented GPU)<br/>OpenMM MM-GBSA<br/>BoTorch/TuRBO (no wet-lab readout to learn from)<br/>self-hosted BoltzGen on Modal GPU -- REJECTED by Mathew 2026-10-20,<br/>PR #13 CLOSED, off the table (break-even was ~3-4k designs)"]

    style L1 fill:#1f4e79,color:#fff
    style L2 fill:#1f4e79,color:#fff
    style I5 fill:#1f6b3a,color:#fff
    style PANEL fill:#1f6b3a,color:#fff
    style M4 fill:#7a1f1f,color:#fff
    style C2 fill:#7a5a1f,color:#fff
    style APPR fill:#7a5a1f,color:#fff
    style REM fill:#3a3a3a,color:#fff,stroke-dasharray: 5 5
